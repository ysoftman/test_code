{
  "name": "tsparticles-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "tsc && rm -rf dist && bun build ./index.html --outdir=dist --production",
    "preview": "bunx serve dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@tsparticles/all": "^4.3.0",
    "@tsparticles/engine": "^4.3.0"
  }
}
