{
  "name": "particle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "tsc && rm -rf dist && bun build ./index.html --outdir=dist --production && cp -r public/. dist/",
    "preview": "bunx serve dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/matter-js": "^0.20.2",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "pixi.js": "^8.19.0"
  }
}
